{
  "name": "pedacos-de-sonho",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:i18n",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build:i18n": "esbuild i18n/main.ts --bundle --format=iife --outfile=js/i18n.js --target=es2020",
    "check:i18n": "tsc --noEmit && node scripts/check-i18n.mjs",
    "i18n": "npm run build:i18n && npm run check:i18n",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  }
}
